# LUX 本地 Agent 运行配置（由 start_web.ps1 自动加载）
# 复制本文件为 .env 后按需修改；.env 已加入 .gitignore，不要提交真实密码。
#
# 运行目录（可选）：代码通过 Git 发布，业务数据/配置/日志可以放在仓库之外，
# 这样更新代码不会碰到数据，备份与回退也只需针对这些目录。留空即保持旧行为。
# LUX_DATA_DIR=D:\LUX-data\data
# LUX_CONFIG_DIR=D:\LUX-data\config
# LUX_LOG_DIR=D:\LUX-data\logs
# 密钥文件本身也可以放到仓库外（start_web.ps1 / healthcheck.ps1 / deploy 脚本都认）。
# LUX_ENV_FILE=D:\LUX-data\.env
LUX_MODEL_MODE=local
OLLAMA_MODEL=qwen2.5:3b
# 图片附件由独立视觉模型处理；低内存机器完成后立即卸载视觉模型。
LUX_VISION_ENABLED=true
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_VISION_KEEP_ALIVE=0
LUX_REQUEST_TIMEOUT=600
# 事件中心是否显示“事件处置”（默认 true；false 则只保留奖惩制度参考）
LUX_SHOW_INCIDENT_DESK=true
# 聊天带入最近几轮对话（0 = 关闭）及字数上限；本地模型会按上下文长度自动收缩
LUX_HISTORY_TURNS=3
LUX_HISTORY_CHARS=1800
# 单条历史消息的字数上限；超长时保留开头、强制保留结尾约束（如“不要表格”“300 字”）
LUX_HISTORY_MSG_CHARS=600
# 活跃任务状态在内存里保留多久（秒），按账号隔离；超时视为新任务
LUX_CONVERSATION_TTL=3600
# 意图路由：规则优先，规则无法决断时才调用本地模型（JSON，低温度）
# 关闭后不调用模型，无法决断的句子直接按普通对话处理
LUX_INTENT_ROUTER=true
LUX_INTENT_ROUTER_TEMPERATURE=0.0
# 是否向使用者显示程序错误详情（默认 false）
LUX_SHOW_ERRORS=false

# 联网搜索（默认关闭）。开启后在智能工作台出现“联网搜索”开关，
# 用户勾选后本轮提问会发往搜索服务；需配置 TAVILY_API_KEY（只放服务端环境变量）。
LUX_WEB_SEARCH_ENABLED=true
LUX_WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=在此填写服务端密钥（不要提交到仓库）
LUX_WEB_SEARCH_TIMEOUT=10
LUX_WEB_SEARCH_MAX_RESULTS=4
# 网页前台语音唤醒助手（默认关闭）。开启后智能工作台出现“语音助手”按钮，
# 登录并主动点击开启后，浏览器本地检测“小安小安”唤醒词；未唤醒时不上传环境音频。
# 唤醒词当前固定为“小安小安”，如需更换需重新生成模型 token（见 docs/CLAUDE_TTS_AND_VOICE_CONVERSATION_PLAN.md）。
LUX_VOICE_DIALOGUE_ENABLED=false

# 回答朗读（本地 TTS，默认关闭）。开启后聊天回答旁出现“朗读/停止/自动朗读”。
# 使用 sherpa-onnx + Kokoro 中文多语模型，先运行 install_tts.ps1 下载到 models/tts/。
# 音色可设 zf_xiaobei/zf_xiaoni/zf_xiaoxiao/zf_xiaoyi（女）或 zm_yunjian/zm_yunxi/zm_yunxia/zm_yunyang（男）。
LUX_TTS_ENABLED=false
LUX_TTS_PROVIDER=local
# 留空则用仓库内默认 models/tts/kokoro-int8-multi-lang-v1_0
LUX_TTS_MODEL_DIR=
LUX_TTS_VOICE=zf_xiaoxiao
LUX_TTS_SPEED=1.0
# 单次合成最大字符数（超出按句末截断）与音频临时文件保留秒数
LUX_TTS_MAX_CHARS=2000
LUX_TTS_AUDIO_TTL=1800

# 语音对话闭环（里程碑 C）：VAD 停顿/超时与追问窗口，可按真实中文讲话测量后调整。
# 停顿阈值：讲话中能量低于阈值持续这么久，判定本轮讲完。
LUX_VAD_PAUSE_MS=800
# 等待开口超时：进入聆听后这么久还没检测到语音，返回等待唤醒。
LUX_VAD_SILENCE_TIMEOUT_MS=8000
# 单轮最大录音时长，防止误判停顿导致无限录音。
LUX_VAD_MAX_TURN_MS=20000
# 最短有效语音时长：短于此按噪声忽略，避免咳嗽/点击被当成问题提交。
LUX_VAD_MIN_SPEECH_MS=400
# VAD 能量阈值（RMS，归一化 16 位音频）。越低越灵敏，越高越抗噪。
LUX_VAD_ENERGY_THRESHOLD=0.02
# 回答播完后的追问窗口时长（毫秒），超时返回等待唤醒。
LUX_VOICE_FOLLOWUP_MS=10000
# 登录失败锁定：连续失败次数 / 统计窗口秒数 / 锁定秒数
LUX_LOGIN_MAX_FAILURES=5
LUX_LOGIN_WINDOW_SECONDS=600
LUX_LOGIN_LOCK_SECONDS=900
NO_PROXY=127.0.0.1,localhost

# 局域网共享：同事用浏览器访问 http://<本机IP>:7860，需要个人账号登录。
# 以下旧账号仅用于账号库为空时创建首个管理员；创建成功后请从 .env 删除这两行。
LUX_HOST=127.0.0.1
LUX_APP_USERNAME=security
LUX_APP_PASSWORD=请设置强密码
